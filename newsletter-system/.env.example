# Copy this file to .env and fill in your real values. Never commit .env.

# --- Outlook / Office 365 sending account ---
# Use an "App Password" if your account has MFA enabled
# (Outlook.com: account.live.com/proofs/AppPassword)
# (Office 365 work/school: depends on your admin's MFA policy)
EMAIL_USER=you@outlook.com
EMAIL_PASSWORD=your-app-password
# Personal Outlook.com/Hotmail account -> smtp-mail.outlook.com
# Work/school Microsoft 365 account   -> smtp.office365.com
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# --- App security ---
# Password to log into the /dashboard (compose + send screen)
ADMIN_PASSWORD=change-me
# Random long string used to sign session cookies
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- Public base URL of this app ---
# Needed so unsubscribe links in emails point somewhere reachable.
# When running locally for testing this can stay as localhost, but
# subscribe/unsubscribe links only work for recipients if you deploy
# this app somewhere with a real public URL.
BASE_URL=http://localhost:5000

# --- Required by CAN-SPAM law: shown in every email footer ---
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=123 Main St, Suite 100, Your City, ST 00000
